# ============================================================
# FICHIER DE CONFIGURATION — SALESBOT IA MULTI-CANAUX
# COPIE CE FICHIER EN .env ET REMPLIS LES VALEURS
# ============================================================

# ── OPENAI (OBLIGATOIRE) ────────────────────────────────────
# Va sur platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ── BOT ─────────────────────────────────────────────────────────
BOT_NAME=Sophie
PRODUCT_NAME=Formation Business en ligne
FOLLOWUP_DAY_1=1
FOLLOWUP_DAY_2=3
FOLLOWUP_DAY_3=7

# ── TELEGRAM (5 minutes de setup) ───────────────────────────
# 1. Ouvre Telegram → cherche @BotFather
# 2. Envoie /newbot → choisis un nom et un username
# 3. Copie le TOKEN donné par BotFather ci-dessous
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EMAIL GMAIL (configuration IMAP/SMTP) ──────────────────
# 1. Active IMAP dans Gmail: Paramètres → Voir tous → Transfert et POP/IMAP
# 2. Créa un mot de passe d'application: myaccount.google.com → Sécurité
#    → Connexion à Google → Mots de passe des applications
# 3. Utilise CE MOT DE PASSE (16 caractères), PAS ton vrai mot de passe !
EMAIL_USER=ton.email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_CHECK_INTERVAL_MIN=2

# ── INSTAGRAM / META (DMs Instagram) ───────────────────────
# Va sur developers.facebook.com → Créer une app → Instagram
META_APP_ID=xxxxxxxxxxxxxx
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_VERIFY_TOKEN=mon_token_secret_2024
INSTAGRAM_ACCOUNT_ID=xxxxxxxxxxxxxxxxxx

# ── VAPI.AI (APPELS VOCAUX IA) ──────────────────────────────
# Crée un compte sur vapi.ai → Settings → API Keys
VAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_ASSISTANT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AIRTABLE (CRM - OPTIONNEL) ──────────────────────────────
AIRTABLE_API_KEY=keyxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_NAME=Leads

# ── SERVEUR ─────────────────────────────────────────────────
PORT=3000
SERVER_URL=http://localhost:3000
